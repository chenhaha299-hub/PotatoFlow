{
  "name": "potatoflow-web",
  "version": "0.8.7",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:lan": "vinext dev --hostname 0.0.0.0 --port 3001",
    "dev:test": "vinext dev --hostname 127.0.0.1 --port 3001 --mode test",
    "build": "vinext build && node scripts/normalize-wrangler.mjs",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test:e2e": "npm run build && node e2e/run-e2e.mjs",
    "test:e2e:direct": "playwright test"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "mammoth": "^1.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.59.3",
    "vinext": "^0.2.1",
    "vite": "^8.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "wrangler": "^4.118.0"
  },
  "type": "module"
}
